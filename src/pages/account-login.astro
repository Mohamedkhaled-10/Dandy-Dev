---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import AuthEditorialLayout from '../components/account/AuthEditorialLayout.astro';

const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const canonicalUrl = 'https://dandy-ebon.vercel.app/account-login';
---

<BaseLayout
  title="تسجيل دخول العميلة | Dandy Cosmetics"
  description="سجّلي الدخول إلى حسابك في داندي لمتابعة طلباتك، تعديل عناوين الشحن، ومشاهدة قائمتك المفضلة."
  canonical={canonicalUrl}
  robots="noindex, follow"
>
  <Fragment slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <AuthEditorialLayout
    mainId="loginMain"
    cardId="loginCard"
    formAriaLabel="نموذج تسجيل الدخول"
    eyebrow="حساب العميلة"
    title="تسجيل الدخول"
    subtitle="أدخلي بريدكِ الإلكتروني وكلمة المرور للوصول إلى طلباتكِ وعناوينكِ المحفوظة."
    quoteTag="عالم داندي للعناية الطبيعية"
    quoteLine1="روتين عناية متوازن"
    quoteHighlight="بتركيبات نباتية موثوقة"
  >
    <div id="loginAlert" class="dandy-auth-alert" role="alert" aria-live="assertive"></div>

    <form id="customerLoginForm" novalidate data-dandy-entrance="1">
      <div class="dandy-auth-field-group">
        <label for="cl-email">
          <span>البريد الإلكتروني <span class="dandy-auth-req" aria-hidden="true">*</span></span>
        </label>
        <input
          type="email"
          id="cl-email"
          name="email"
          class="dandy-auth-input"
          placeholder="name@example.com"
          required
          dir="ltr"
          autocomplete="email"
        />
      </div>

      <div class="dandy-auth-field-group">
        <label for="cl-pass">
          <span>كلمة المرور <span class="dandy-auth-req" aria-hidden="true">*</span></span>
        </label>
        <div class="dandy-auth-input-wrap">
          <input
            type="password"
            id="cl-pass"
            name="password"
            class="dandy-auth-input dandy-auth-input--password"
            placeholder="••••••••"
            required
            autocomplete="current-password"
          />
          <button
            type="button"
            class="dandy-auth-pw-toggle"
            data-dandy-pw-toggle
            data-target="cl-pass"
            aria-label="إظهار كلمة المرور"
            aria-pressed="false"
          >
            <Icon name="eye" size={18} strokeWidth={1.85} />
          </button>
        </div>
      </div>

      <div class="dandy-auth-options">
        <label class="dandy-auth-remember" for="rememberMeCheckbox">
          <input type="checkbox" id="rememberMeCheckbox" class="dandy-auth-checkbox" />
          <span>تذكرني</span>
        </label>

        <button type="button" id="forgotPassBtn" class="dandy-auth-forgot">
          نسيتِ كلمة السر؟
        </button>
      </div>

      <div class="dandy-auth-turnstile-wrap">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
      </div>

      <button type="submit" id="loginSubmitBtn" class="dandy-btn dandy-btn--editorial dandy-auth-submit">
        <span data-submit-label>تسجيل الدخول</span>
        <Icon name="arrow-left" size={17} strokeWidth={1.85} directional={true} />
      </button>
    </form>

    <div class="dandy-auth-switch" data-dandy-entrance="2">
      <div>
        ليس لديكِ حساب؟ <a href="/account-signup">إنشاء حساب جديد</a>
      </div>
      <div class="dandy-auth-alt-note">
        يمكنكِ أيضاً متابعة طلبكِ دون تسجيل عبر <a href="/track-order">صفحة تتبع الطلب</a>
      </div>
    </div>
  </AuthEditorialLayout>

  <script>
    import { initCustomerLoginPage } from '../scripts/account-auth-client';
    initCustomerLoginPage();
  </script>
</BaseLayout>
