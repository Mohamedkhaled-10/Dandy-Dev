---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import AuthEditorialLayout from '../components/account/AuthEditorialLayout.astro';

const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const canonicalUrl = 'https://dandy-ebon.vercel.app/account-signup';
---

<BaseLayout
  title="إنشاء حساب جديد | Dandy Cosmetics"
  description="انضمي إلى عائلة داندي وتابعي طلباتك السابقة، عناوينك المحفوظة، وقائمتك المفضلة بكل سهولة."
  canonical={canonicalUrl}
  robots="noindex, follow"
>
  <Fragment slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <AuthEditorialLayout
    mainId="signupMain"
    cardId="signupCard"
    formAriaLabel="نموذج إنشاء حساب جديد"
    eyebrow="حساب جديد"
    title="إنشاء حساب عميلة جديدة"
    subtitle="سجّلي برقم هاتفكِ لربط طلباتكِ السابقة تلقائياً وحفظ عناوين الشحن والمفضلة."
    quoteTag="تجربة تسوق متكاملة"
    quoteLine1="احفظي عناوينكِ"
    quoteHighlight="وتابعي طلباتكِ بسهولة"
  >
    <div id="signupAlert" class="dandy-auth-alert" role="alert" aria-live="assertive"></div>

    <form id="signupForm" novalidate data-dandy-entrance="1">
      <div class="dandy-auth-field-group">
        <label for="c-name">
          <span>الاسم بالكامل <span class="dandy-auth-req" aria-hidden="true">*</span></span>
        </label>
        <input
          type="text"
          id="c-name"
          name="name"
          class="dandy-auth-input"
          placeholder="مثال: سارة أحمد"
          required
          autocomplete="name"
        />
      </div>

      <div class="dandy-auth-field-group">
        <label for="c-phone">
          <span>رقم الهاتف <span class="dandy-auth-req" aria-hidden="true">*</span></span>
          <span class="dandy-auth-label-hint">يُستخدم لربط طلباتكِ</span>
        </label>
        <input
          type="tel"
          id="c-phone"
          name="phone"
          class="dandy-auth-input"
          placeholder="01xxxxxxxxx"
          required
          dir="ltr"
          autocomplete="tel"
        />
      </div>

      <div class="dandy-auth-field-group">
        <label for="c-email">
          <span>البريد الإلكتروني <span class="dandy-auth-req" aria-hidden="true">*</span></span>
        </label>
        <input
          type="email"
          id="c-email"
          name="email"
          class="dandy-auth-input"
          placeholder="name@example.com"
          required
          dir="ltr"
          autocomplete="email"
        />
      </div>

      <div class="dandy-auth-field-group">
        <label for="c-pass">
          <span>كلمة المرور <span class="dandy-auth-req" aria-hidden="true">*</span></span>
          <span class="dandy-auth-label-hint">6 أحرف على الأقل</span>
        </label>
        <div class="dandy-auth-input-wrap">
          <input
            type="password"
            id="c-pass"
            name="password"
            class="dandy-auth-input dandy-auth-input--password"
            placeholder="••••••••"
            required
            minlength="6"
            autocomplete="new-password"
          />
          <button
            type="button"
            class="dandy-auth-pw-toggle"
            data-dandy-pw-toggle
            data-target="c-pass"
            aria-label="إظهار كلمة المرور"
            aria-pressed="false"
          >
            <Icon name="eye" size={18} strokeWidth={1.85} />
          </button>
        </div>
      </div>

      <div class="dandy-auth-turnstile-wrap">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
      </div>

      <button type="submit" id="signupSubmitBtn" class="dandy-btn dandy-btn--primary dandy-auth-submit">
        <span data-submit-label>إنشاء الحساب</span>
        <Icon name="arrow-left" size={17} strokeWidth={1.85} directional={true} />
      </button>
    </form>

    <div class="dandy-auth-switch" data-dandy-entrance="2">
      <div>
        لديكِ حساب بالفعل؟ <a href="/account-login">تسجيل الدخول</a>
      </div>
    </div>
  </AuthEditorialLayout>

  <script>
    import { initCustomerSignupPage } from '../scripts/account-auth-client';
    initCustomerSignupPage();
  </script>
</BaseLayout>
