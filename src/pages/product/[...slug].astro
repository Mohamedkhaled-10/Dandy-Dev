};
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  robots={isNotFound ? 'noindex, nofollow' : 'index, follow'}
>
  <Fragment slot="head">
    <meta property="og:type" content="product" />
    <meta property="og:title" id="og-title-meta" content={pageTitle} />
    <meta property="og:description" id="og-desc-meta" content={metaDescription} />
    <meta property="og:image" id="og-image-meta" content={ogImage} />
    <meta property="og:url" id="og-url-meta" content={canonicalUrl} />
    <meta property="og:site_name" content="داندي كوزمتكس - Dandy Cosmetics" />
    {product && !isNotFound && (
      <>
        <meta property="product:price:amount" content={String(pricing.unitBasePrice)} />
        <meta property="product:price:currency" content="EGP" />
        <meta property="product:availability" content={isAvailable ? 'in stock' : 'out of stock'} />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script id="product-jsonld" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    {breadcrumbJsonLd && (
      <script id="breadcrumb-jsonld" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
  </Fragment>

  <main class="dandy-pdp-main" dir="rtl">
    {isNotFound ? (
      <section class="dandy-container dandy-pdp-notfound-wrap">
        <div class="dandy-pdp-notfound" id="product-not-found-view">
          <span class="dandy-pdp-notfound-icon" aria-hidden="true">
            <Icon name="search" size={28} strokeWidth={1.7} />
          </span>
          <h1>عذراً، المستحضر المطلوب غير متوفر</h1>
          <p>
            قد يكون الرابط الذي اتبعتهِ غير صحيح أو تم تحديث اسم المنتج في تشكيلة داندي كوزمتكس.
          </p>
          <a href="/all-products" class="dandy-btn dandy-btn--editorial dandy-btn--pill">
            <Icon name="grid" size={16} strokeWidth={1.8} />
            <span>استكشفي جميع مستحضرات داندي</span>
          </a>
        </div>
      </section>
    ) : (
      <>
        <!-- 1. Breadcrumb & Primary Hero Split -->
        <section class="dandy-pdp-hero">
          <div class="dandy-container">
            <nav class="dandy-pdp-breadcrumb" id="product-breadcrumb" aria-label="مسار التنقل">
              <a href="/">الرئيسية</a>
              <Icon name="chevron-left" size={14} strokeWidth={1.8} class="dandy-pdp-bread-sep" />
              <a href={`/category/${categoryMeta.slug}`}>{categoryMeta.labelAr}</a>
              <Icon name="chevron-left" size={14} strokeWidth={1.8} class="dandy-pdp-bread-sep" />
              <span class="current" id="bread-product">{productName}</span>
            </nav>

            <!-- RTL Grid: Gallery (Right visual column) | Info & Purchase Controls (Left visual column) -->
            <div class="dandy-pdp-grid" id="detailFrame">
              <div class="dandy-pdp-col-gallery">
                <ProductGallery
                  productId={product!.id}
                  productName={product!.name}
                  images={galleryImages}
                  badge={stageBadge}
                  isSoldOut={isSoldOut}
                />
              </div>

              <div class="dandy-pdp-col-info">
                <ProductInfo
                  productId={product!.id}
                  productName={product!.name}
                  categorySlug={categoryMeta.slug}
                  categoryLabelAr={categoryMeta.labelAr}
                  isSoldOut={isSoldOut}
                  pricing={pricing}
                  hasVariants={hasVariants}
                  variants={variantsList}
                  parsedDescription={parsedDescription}
                  highlights={highlights}
                  reviewStats={reviewStats}
                  waLink={waLink}
                  shareWaLink={shareWaLink}
                  shareFbLink={shareFbLink}
                  shareIgLink={shareIgLink}
                  shareMessengerLink={shareMessengerLink}
                  canonicalUrl={canonicalUrl}
                />
              </div>
            </div>
          </div>
        </section>

        <!-- 2. Structured Product Details & Editorial Routine Guide -->
        <section
          class="dandy-pdp-details-section"
          id="details-editorial-section"
          aria-labelledby="details-section-heading"
        >
          <div class="dandy-container">
            <header class="dandy-pdp-section-head">
              <p class="dandy-pdp-section-kicker">تفاصيل التركيبة والعناية</p>
              <h2 id="details-section-heading" class="dandy-pdp-section-heading">
                تفاصيل وخواص المستحضر
              </h2>
            </header>

            <div class="dandy-pdp-details-layout">
              <div id="product-desc" class="dandy-pdp-desc-stack dandy-prose">
                {parsedDescription.sections.length > 0 ? (
                  parsedDescription.sections.map((section) => (
                    <article class="dandy-pdp-desc-card" data-desc-section={section.id}>
                      <h3 class="dandy-pdp-desc-title">
                        <span class="dandy-pdp-desc-icon" aria-hidden="true">
                          <Icon name={SECTION_ICONS[section.id] || 'sparkles'} size={17} strokeWidth={1.8} />
                        </span>
                        <span>{section.title}</span>
                      </h3>

                      {section.paragraphs.map((para) => (
                        <p class="dandy-pdp-desc-p">{para}</p>
                      ))}

                      {section.bullets.length > 0 && (
                        <ul class:list={['dandy-pdp-desc-list', { 'is-steps': section.id === 'usage' }]}>
                          {section.bullets.map((bullet, idx) => (
                            <li>
                              {section.id === 'usage' ? (
                                <span class="dandy-pdp-step-num dandy-tabular" aria-hidden="true">{idx + 1}</span>
                              ) : (
                                <Icon name="check" size={15} strokeWidth={2.2} class="dandy-pdp-bullet-icon" />
                              )}
                              <span>{bullet}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </article>
                  ))
                ) : (
                  <article class="dandy-pdp-desc-card">
                    <h3 class="dandy-pdp-desc-title">
                      <span class="dandy-pdp-desc-icon" aria-hidden="true">
                        <Icon name="book-open" size={17} strokeWidth={1.8} />
                      </span>
                      <span>وصف المستحضر</span>
                    </h3>
                    <p class="dandy-pdp-desc-p">{parsedDescription.leadIntro}</p>
                  </article>
                )}
              </div>

              {productArticle && (
                <aside class="dandy-pdp-routine-aside" aria-label="دليل العناية والروتين">
                  <div class="dandy-pdp-routine-card">
                    <span class="dandy-pdp-routine-kicker">
                      <Icon name="book-open" size={15} strokeWidth={1.9} />
                      <span>{productArticle.label}</span>
                    </span>
                    <p class="dandy-pdp-routine-copy">
                      {productArticle.leadText}{' '}
                      <a href={productArticle.articleUrl} class="dandy-pdp-routine-link">
                        {productArticle.anchorText}
                      </a>
                      {productArticle.tailText ? ` ${productArticle.tailText}` : ''}
                    </p>
                    <a href={productArticle.articleUrl} class="dandy-btn dandy-btn--outline">
                      <span>قراءة الدليل الكامل</span>
                      <Icon name="arrow-left" size={15} strokeWidth={1.8} />
                    </a>
                  </div>
                </aside>
              )}
            </div>
          </div>
        </section>

        <!-- 3. Verified Customer Reviews Panel -->
        <ReviewSummaryPanel reviewStats={reviewStats} />

        <!-- 4. Related Products (Unified Phase 3 ProductCard) -->
        {relatedProducts.length > 0 && (
          <section
            class="dandy-pdp-related-section"
            id="related-products-section"
            aria-labelledby="related-products-heading"
          >
            <div class="dandy-container">
              <header class="dandy-pdp-related-header">
                <div>
                  <p class="dandy-pdp-section-kicker">تكمّل روتينكِ</p>
                  <h2 id="related-products-heading" class="dandy-pdp-section-heading">
                    مستحضرات مقترحة من نفس الفئة
                  </h2>
                </div>
                <a href={`/category/${categoryMeta.slug}`} class="dandy-pdp-related-more">
                  <span>عرض {categoryMeta.labelAr}</span>
                  <Icon name="arrow-left" size={15} strokeWidth={1.8} />
                </a>
              </header>

              <div class="dandy-pdp-related-grid" id="related-products-grid">
                {relatedProducts.map((relProd) => {
                  const relPfPricing = livePfCampaign
                    ? calculatePinkFridayPricing(relProd, livePfCampaign)
                    : null;
                  return (
                    <ProductCard
                      product={relProd}
                      pinkFridayPricing={relPfPricing}
                      priority={true}
                    />
                  );
                })}
              </div>
            </div>
          </section>
        )}

        <script
          id="pdp-bootstrap-data"
          type="application/json"
          set:html={JSON.stringify({
            product,
            canonicalUrl,
            pinkFridayPricing: pfPricing,
          })}
        />
      </>
    )}
  </main>

  {!isNotFound && (
    <script>
      import { initProductDetailPage } from '../../scripts/pdp-client';
      initProductDetailPage();
    </script>
  )}
</BaseLayout>

