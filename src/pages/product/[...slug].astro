---
// src/pages/product/[...slug].astro
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import ProductGallery from '../../components/commerce/ProductGallery.astro';
import ProductInfo from '../../components/commerce/ProductInfo.astro';
import ReviewSummaryPanel from '../../components/commerce/ReviewSummaryPanel.astro';
import {
  getAllProducts,
  getProductBySlug,
  getProductById,
  generateProductJsonLd,
  SITE_URL,
  type Product,
} from '../../utils/products';
import {
  getPublishedPinkFridayCampaign,
  calculatePinkFridayPricing,
} from '../../utils/pink-friday-server';
import {
  isProductSoldOut,
  normalizeProductVariants,
  resolveCategoryArabicLabel,
} from '../../scripts/product-card';
import {
  computePdpEffectivePricing,
  computeReviewStats,
  extractProductHighlights,
  normalizeProductGalleryImages,
  parseDescriptionSections,
  selectRelatedProducts,
  type ReviewRecordInput,
} from '../../scripts/product-pdp';

const RTDB_URL = 'https://dandy-562fc-default-rtdb.europe-west1.firebasedatabase.app';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/all-products', 301);
}

const [livePfCampaign, allProducts] = await Promise.all([
  getPublishedPinkFridayCampaign(),
  getAllProducts(),
]);

// 1. Resolve product by slug
let product: Product | null = await getProductBySlug(slug);

// 2. Legacy ID fallback redirect (301) preserving tracking query params
if (!product) {
  const productById = await getProductById(slug);
  if (productById) {
    const searchParams = new URLSearchParams();
    for (const [k, v] of Astro.url.searchParams.entries()) {
      if (k.startsWith('utm_') || k === 'fbclid' || k === 'gclid') {
        searchParams.set(k, v);
      }
    }
    const qs = searchParams.toString() ? `?${searchParams.toString()}` : '';
    return Astro.redirect(`/product/${encodeURIComponent(productById.resolvedSlug)}${qs}`, 301);
  }
}

// 3. Handle 404 when missing or hidden
const isNotFound = !product || product.isHidden;
if (isNotFound) {
  Astro.response.status = 404;
}

// 4. Enforce canonical slug URL (301 redirect for non-canonical alias)
if (product && !product.isHidden) {
  const reqSlug = decodeURIComponent(slug).toLowerCase().trim();
  if (reqSlug !== product.resolvedSlug.toLowerCase()) {
    const searchParams = new URLSearchParams();
    for (const [k, v] of Astro.url.searchParams.entries()) {
      if (k.startsWith('utm_') || k === 'fbclid' || k === 'gclid') {
        searchParams.set(k, v);
      }
    }
    const qs = searchParams.toString() ? `?${searchParams.toString()}` : '';
    return Astro.redirect(`/product/${encodeURIComponent(product.resolvedSlug)}${qs}`, 301);
  }
}

// 5. Fetch real reviews SSR from public RTDB endpoint (never fabricated)
let rawReviews: Record<string, ReviewRecordInput> | null = null;
if (product && !isNotFound) {
  try {
    const revRes = await fetch(
      `${RTDB_URL}/reviews/${encodeURIComponent(product.id)}.json`,
      {
        headers: { Accept: 'application/json' },
        signal: AbortSignal.timeout(3500),
      }
    );
    if (revRes.ok) {
      const parsedJson = await revRes.json();
      if (parsedJson && typeof parsedJson === 'object') {
        rawReviews = parsedJson as Record<string, ReviewRecordInput>;
      }
    }
  } catch {
    rawReviews = null;
  }
}

const reviewStats = computeReviewStats(rawReviews);

// 6. SEO & Structured Data
const productName = product?.name || 'المنتج غير متوفر';
const pageTitle = product && !isNotFound
  ? `${product.name} | داندي كوزمتكس - Dandy Cosmetics`
  : 'المنتج غير موجود (404) | داندي كوزمتكس';

const rawDesc = (product?.description || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const metaDescription = rawDesc
  ? (rawDesc.length > 155 ? rawDesc.substring(0, 155) + '...' : rawDesc)
  : (product && !isNotFound
      ? `${product.name} - مستحضر للعناية بالجمال من داندي كوزمتكس مصر.`
      : 'المنتج المطلوب غير متوفر حالياً في متجر داندي كوزمتكس.');

const canonicalUrl = product && !isNotFound
  ? `${SITE_URL}/product/${encodeURIComponent(product.resolvedSlug)}`
  : `${SITE_URL}/all-products`;

const ogImage = (product?.image && !product.image.includes('images.unsplash.com'))
  ? product.image
  : `${SITE_URL}/assets/images/fav-icons/android-chrome-512x512.png`;

const categoryMeta = product
  ? resolveCategoryArabicLabel(product)
  : { slug: 'skin-care', labelAr: 'العناية بالبشرة' };

const productForJsonLd = product && !isNotFound
  ? {
      ...product,
      ...(reviewStats.count > 0
        ? { avgRating: reviewStats.average, reviewCount: reviewStats.count }
        : {}),
    }
  : null;

const jsonLd = productForJsonLd ? generateProductJsonLd(productForJsonLd, canonicalUrl) : null;
const breadcrumbJsonLd = product && !isNotFound
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE_URL}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryMeta.labelAr,
          item: `${SITE_URL}/category/${categoryMeta.slug}`,
        },
        { '@type': 'ListItem', position: 3, name: product.name, item: canonicalUrl },
      ],
    }
  : null;

// 7. Compute Grounded View Models
const pfPricing = product && !isNotFound ? calculatePinkFridayPricing(product, livePfCampaign) : null;
const pricing = product && !isNotFound
  ? computePdpEffectivePricing(product, 0, pfPricing)
  : computePdpEffectivePricing({ price: 0, onSale: false }, 0, null);

const isSoldOut = product ? isProductSoldOut(product) : false;
const isAvailable = Boolean(product && !isSoldOut && !isNotFound);

const galleryImages = product && !isNotFound
  ? normalizeProductGalleryImages(product)
  : [];

const stageBadge = isSoldOut
  ? { text: 'نفذت الكمية', tone: 'soldout' as const }
  : pricing.isPinkFriday
    ? { text: pricing.campaignBadgeText || 'Pink Friday', tone: 'campaign' as const }
    : pricing.discountPercent
      ? { text: `خصم ${pricing.discountPercent}%`, tone: 'discount' as const }
      : null;

const variantsList = product ? normalizeProductVariants(product.variants) : [];
const hasVariants = Boolean(
  product &&
  (product.hasVariants === true || (product.hasVariants as unknown) === 'true') &&
  variantsList.length > 0
);

const parsedDescription = parseDescriptionSections(product?.description);
const highlights = product && !isNotFound
  ? extractProductHighlights(product, parsedDescription)
  : [];

const relatedProducts = product && !isNotFound
  ? selectRelatedProducts(allProducts, product, 4)
  : [];

// 8. WhatsApp & Social Share URLs
const waPhone = '201038941005';
const waMessage = product
  ? `مرحباً داندي، أود الاستفسار عن هذا المنتج:\n- اسم المنتج: ${product.name}\n- الرابط: ${canonicalUrl}`
  : '';
const waLink = `https://wa.me/${waPhone}?text=${encodeURIComponent(waMessage)}`;
const shareWaLink = product ? `https://wa.me/?text=${encodeURIComponent(product.name + '\n' + canonicalUrl)}` : '#';
const shareFbLink = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`;
const shareIgLink = 'https://www.instagram.com/dandy_skincare_cosmotics';
const shareMessengerLink = 'https://www.facebook.com/profile.php?id=61563039704396';

// 9. Approved Product-to-Article Editorial Guides (Preserved)
interface ProductArticleGuide {
  label: string;
  leadText: string;
  anchorText: string;
  tailText?: string;
  articleUrl: string;
