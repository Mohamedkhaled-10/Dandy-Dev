---
/**
 * DANDY COSMETICS — BOTANICAL EDITORIAL HOMEPAGE (PHASE 3)
 * SSR-first architecture: immediate above-the-fold editorial content, real catalog data,
 * unified ProductCard showcase, grounded brand story, and conditional Pink Friday banner.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroEditorial from '../components/home/HeroEditorial.astro';
import CategoryDiscovery from '../components/home/CategoryDiscovery.astro';
import FeaturedProducts from '../components/home/FeaturedProducts.astro';
import PinkFridayHomeSection from '../components/home/PinkFridayHomeSection.astro';
import EditorialBrandStory from '../components/home/EditorialBrandStory.astro';
import { getAllProducts } from '../utils/products';
import {
  getPublishedPinkFridayCampaign,
  shouldDisplayCampaignToCustomers,
} from '../utils/pink-friday-server';
import { selectFeaturedProducts } from '../scripts/product-card';

const [allProducts, publishedPfCampaign] = await Promise.all([
  getAllProducts(),
  getPublishedPinkFridayCampaign(),
]);

const featuredProducts = selectFeaturedProducts(allProducts, 8);
const showPfSection = shouldDisplayCampaignToCustomers(publishedPfCampaign);
---

<BaseLayout
  title="داندي | Dandy Cosmetics - منتجات طبيعية للعناية بالبشرة والشعر"
  description="تسوقي الآن من متجر داندي (Dandy Cosmetics)، وجهتك الأولى لأفضل منتجات العناية بالبشرة والشعر الطبيعية في مصر. اكتشفي الجمال الطبيعي اليوم!"
  keywords="Dandy, Dandy Cosmetics, دندي, داندي, دندي للتجميل, العناية بالبشرة, العناية بالشعر, مستحضرات تجميل طبيعية, منتجات دندي, Natural Skincare, Beauty Store Egypt"
  canonical="https://dandy-ebon.vercel.app/"
>
  <slot name="head" slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dandy-ebon.vercel.app/" />
    <meta property="og:title" content="داندي | Dandy Cosmetics - منتجات طبيعية للعناية بالبشرة والشعر" />
    <meta property="og:description" content="تسوقي الآن من متجر داندي (Dandy Cosmetics)، وجهتك الأولى لأفضل منتجات العناية بالبشرة والشعر الطبيعية في مصر." />
    <meta property="og:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="داندي | Dandy Cosmetics - منتجات طبيعية للعناية بالبشرة والشعر" />
    <meta name="twitter:description" content="تسوقي الآن من متجر داندي (Dandy Cosmetics)، وجهتك الأولى لأفضل منتجات العناية بالبشرة والشعر الطبيعية في مصر." />
    <meta name="twitter:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Dandy Cosmetics",
        "alternateName": "داندي",
        "url": "https://dandy-ebon.vercel.app/",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://dandy-ebon.vercel.app/all-products?search={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Dandy Cosmetics",
        "url": "https://dandy-ebon.vercel.app/",
        "logo": "https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg",
        "sameAs": [
          "https://www.facebook.com/profile.php?id=61563039704396",
          "https://www.instagram.com/dandy_skincare_cosmotics"
        ]
      }
    </script>

    <style is:global>
      .dandy-home-main {
        background-color: var(--dandy-bg-page);
        overflow-x: clip;
      }

      .dandy-home-section {
        padding-block: var(--dandy-section-py-desktop);
      }

      .dandy-section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: clamp(24px, 3vw, 36px);
      }

      .dandy-section-titles {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .dandy-section-kicker {
        margin: 0;
        font-family: var(--dandy-font-ar-sans);
        font-size: var(--dandy-text-xs);
        font-weight: 600;
        color: var(--dandy-botanical-deep);
        letter-spacing: 0;
      }

      .dandy-section-heading {
        margin: 0;
        font-family: var(--dandy-font-ar-display);
        font-size: clamp(1.5rem, 2.4vw, 2.15rem);
        font-weight: 700;
        line-height: 1.3;
        color: var(--dandy-ink-primary);
      }

      .dandy-section-more {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 40px;
        font-family: var(--dandy-font-ar-sans);
        font-size: var(--dandy-text-sm);
        font-weight: 600;
        color: var(--dandy-ink-primary);
        text-decoration: none;
        white-space: nowrap;
        border-bottom: 1px solid var(--dandy-border-default);
        padding-bottom: 2px;
        transition: color var(--dandy-transition-fast), border-color var(--dandy-transition-fast);
      }

      .dandy-section-more:hover {
        color: var(--dandy-accent-text);
        border-color: var(--dandy-accent-primary);
      }

      @media (max-width: 767px) {
        .dandy-home-section {
          padding-block: var(--dandy-section-py-mobile);
        }

        .dandy-section-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
          margin-bottom: 22px;
        }
      }
    </style>
  </slot>

  <main class="dandy-home-main" id="main-content">
    <HeroEditorial />
    <CategoryDiscovery />
    <FeaturedProducts
      products={featuredProducts}
      pinkFridayCampaign={publishedPfCampaign}
    />
    {showPfSection && (
      <PinkFridayHomeSection campaign={publishedPfCampaign} />
    )}
    <EditorialBrandStory />
  </main>
</BaseLayout>
