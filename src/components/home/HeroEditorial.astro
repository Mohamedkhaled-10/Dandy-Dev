---
/**
 * DANDY COSMETICS — EDITORIAL HERO SECTION (STUDIO SYNCHRONIZED)
 * Supports Studio multi-slide responsive images (desktop/mobile <picture>),
 * editable slide title/subtitle/CTA copy with grounded Botanical Editorial fallbacks,
 * accessible slide controls, and live STUDIO_UPDATE_STATE preview updates.
 */
import Icon from '../ui/Icon.astro';
import {
  DEFAULT_HERO_SLIDE,
  type ResolvedHeroSlide,
} from '../../scripts/homepage-studio';

export interface Props {
  slides?: ResolvedHeroSlide[];
  hidden?: boolean;
}

const { slides = [], hidden = false } = Astro.props;
const activeSlides: ResolvedHeroSlide[] =
  slides.length > 0
    ? slides
    : [{ index: 0, ...DEFAULT_HERO_SLIDE, hasCustomCopy: false }];

const firstSlide = activeSlides[0];
const multiSlide = activeSlides.length > 1;
---

<section
  class="dandy-hero"
  aria-label="داندي للعناية الطبيعية بالبشرة والشعر"
  data-studio-section="hero"
  hidden={hidden || undefined}
>
  <div class="dandy-container dandy-hero-grid">
    <div class="dandy-hero-copy">
      <p class="dandy-hero-kicker" data-hero-kicker data-dandy-entrance="0">
        Dandy Cosmetics <span aria-hidden="true">·</span> عناية طبيعية برؤية صيدلانية
      </p>

      <h1 class="dandy-hero-title" data-hero-title dir="auto" data-dandy-entrance="1">
        {firstSlide.title}
      </h1>

      <p class="dandy-hero-subtitle" data-hero-subtitle dir="auto" data-dandy-entrance="2">
        {firstSlide.subtitle}
      </p>

      <div class="dandy-hero-actions" data-dandy-entrance="3">
        <a
          href={firstSlide.link}
          class="dandy-btn dandy-btn--editorial dandy-hero-cta"
          data-hero-cta
        >
          <span data-hero-cta-label dir="auto">{firstSlide.buttonText}</span>
          <Icon name="arrow-left" size={16} strokeWidth={1.85} />
        </a>
        <a href="/about-us" class="dandy-btn dandy-btn--outline dandy-hero-secondary-cta">
          <span>فلسفة داندي</span>
        </a>
      </div>

      <dl class="dandy-hero-facts" aria-label="مميزات المتجر" data-dandy-entrance="4">
        <div class="dandy-hero-fact">
          <dt>التركيبات</dt>
          <dd>زيوت نباتية وزبدات مغذية</dd>
        </div>
        <div class="dandy-hero-fact">
          <dt>الشحن والتوصيل</dt>
          <dd>توصيل لكافة محافظات مصر</dd>
        </div>
        <div class="dandy-hero-fact">
          <dt>الشحن المجاني</dt>
          <dd>للطلبات فوق <span class="dandy-tabular">2000</span> ج.م</dd>
        </div>
      </dl>
    </div>

    <div class="dandy-hero-visual">
      <div
        class="dandy-hero-carousel"
        data-hero-carousel
        data-active-index="0"
        data-slide-count={activeSlides.length}
      >
        <div class="dandy-hero-slides" data-hero-slides data-dandy-media-settle>
          {activeSlides.map((slide, idx) => (
            <figure
              class:list={['dandy-hero-frame', { 'is-active': idx === 0 }]}
              data-hero-slide={idx}
              data-duration={slide.durationSeconds}
              data-title={slide.title}
              data-subtitle={slide.subtitle}
              data-button-text={slide.buttonText}
              data-link={slide.link}
              aria-hidden={idx === 0 ? 'false' : 'true'}
            >
              <img
                src={slide.desktopImage}
                data-desktop-src={slide.desktopImage}
                data-mobile-src={slide.mobileImage || ''}
                alt={slide.title || 'مستحضرات داندي للعناية بالبشرة بتركيبات نباتية طبيعية'}
                width="1376"
                height="768"
                loading={idx === 0 ? 'eager' : 'lazy'}
                decoding={idx === 0 ? 'sync' : 'async'}
                fetchpriority={idx === 0 ? 'high' : 'auto'}
                referrerpolicy="no-referrer"
                class="dandy-hero-img"
                onerror="this.onerror=null;this.src='/assets/images/editorial/hero-botanical.jpg';"
              />
            </figure>
          ))}
        </div>

        <div class="dandy-hero-controls" data-hero-controls hidden={!multiSlide || undefined}>
          <button
            type="button"
            class="dandy-hero-nav-btn"
            data-hero-prev
            aria-label="الشريحة السابقة"
          >
            <Icon name="chevron-right" size={16} strokeWidth={2} />
          </button>

          <div class="dandy-hero-dots" role="tablist" aria-label="اختيار شريحة العرض" data-hero-dots>
            {activeSlides.map((_, idx) => (
              <button
                type="button"
                role="tab"
                class:list={['dandy-hero-dot', { 'is-active': idx === 0 }]}
                data-hero-dot={idx}
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-label={`الشريحة رقم ${idx + 1}`}
              ></button>
            ))}
          </div>

          <button
            type="button"
            class="dandy-hero-nav-btn"
            data-hero-next
            aria-label="الشريحة التالية"
          >
            <Icon name="chevron-left" size={16} strokeWidth={2} />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .dandy-hero {
    background-color: var(--dandy-bg-editorial);
    border-bottom: 1px solid var(--dandy-border-subtle);
    padding-block: clamp(32px, 4.5vw, 64px);
    overflow-x: clip;
  }

  .dandy-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "copy visual";
    align-items: center;
    gap: clamp(24px, 3.6vw, 56px);
  }

  .dandy-hero-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    min-width: 0;
  }

  .dandy-hero-kicker {
    margin: 0;
    font-family: var(--dandy-font-ar-sans);
    font-size: var(--dandy-text-xs);
    font-weight: 600;
    color: var(--dandy-botanical-deep);
    letter-spacing: 0;
  }

  .dandy-hero-title {
    margin: 0;
    font-family: var(--dandy-font-ar-display);
    font-size: clamp(2rem, 3.6vw, 3.35rem);
    font-weight: 700;
    line-height: 1.24;
    color: var(--dandy-ink-primary);
    text-wrap: balance;
    max-width: 18ch;
  }

  .dandy-hero-subtitle {
    margin: 0;
    font-size: var(--dandy-text-lead);
    line-height: 1.78;
    color: var(--dandy-ink-secondary);
    max-width: 54ch;
  }

  .dandy-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 6px;
  }

  .dandy-hero-cta {
    padding-inline: 26px;
  }

  .dandy-hero-facts {
    margin: 10px 0 0;
    padding-top: 20px;
    width: 100%;
    border-top: 1px solid var(--dandy-border-subtle);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .dandy-hero-fact {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .dandy-hero-fact dt {
    font-size: var(--dandy-text-xs);
    font-weight: 600;
    color: var(--dandy-ink-muted);
  }

  .dandy-hero-fact dd {
    margin: 0;
    font-size: var(--dandy-text-sm);
    font-weight: 600;
    color: var(--dandy-ink-primary);
  }

  .dandy-hero-visual {
    grid-area: visual;
    width: 100%;
    min-width: 0;
  }

  .dandy-hero-carousel {
    position: relative;
    width: 100%;
  }

  .dandy-hero-slides {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--dandy-radius-md);
    overflow: hidden;
    background-color: var(--dandy-bg-stage);
    border: 1px solid var(--dandy-border-subtle);
  }

  .dandy-hero-frame {
    margin: 0;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms var(--dandy-ease-standard);
  }

  .dandy-hero-frame.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  .dandy-hero-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .dandy-hero-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }

  .dandy-hero-controls[hidden] {
    display: none;
  }

  .dandy-hero-nav-btn {
    width: 34px;
    height: 34px;
    border-radius: var(--dandy-radius-sm);
    border: 1px solid var(--dandy-border-default);
    background-color: var(--dandy-bg-page);
    color: var(--dandy-ink-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--dandy-transition-fast), border-color var(--dandy-transition-fast);
  }

  .dandy-hero-nav-btn:hover {
    background-color: var(--dandy-bg-stage);
    border-color: var(--dandy-ink-primary);
  }

  .dandy-hero-dots {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .dandy-hero-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: var(--dandy-radius-pill);
    border: none;
    background-color: var(--dandy-border-default);
    cursor: pointer;
    transition: width 220ms var(--dandy-ease-out), background-color 220ms var(--dandy-ease-standard);
  }

  .dandy-hero-dot.is-active {
    width: 22px;
    background-color: var(--dandy-ink-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .dandy-hero-frame {
      transition: none;
    }
  }

  /* Standard Desktop (1024px – 1199px): preserve editorial composition cleanly above the fold */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .dandy-hero {
      padding-block: clamp(24px, 3.2vw, 40px);
    }

    .dandy-hero-title {
      font-size: clamp(1.8rem, 3.1vw, 2.55rem);
    }

    .dandy-hero-copy {
      gap: 14px;
    }
  }

  /* Tablet Editorial Composition (768px – 1023px): intentional balanced 2-column layout */
  @media (min-width: 768px) and (max-width: 1023px) {
    .dandy-hero {
      padding-block: 28px 36px;
    }

    .dandy-hero-grid {
      grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
      grid-template-areas: "copy visual";
      gap: 24px;
      align-items: center;
    }

    .dandy-hero-copy {
      gap: 12px;
    }

    .dandy-hero-kicker {
      font-size: 0.72rem;
    }

    .dandy-hero-title {
      font-size: clamp(1.52rem, 2.75vw, 1.98rem);
      line-height: 1.28;
      max-width: 21ch;
    }

    .dandy-hero-subtitle {
      font-size: 0.88rem;
      line-height: 1.62;
    }

    .dandy-hero-actions {
      gap: 8px;
      padding-top: 2px;
    }

    .dandy-hero-actions .dandy-btn {
      padding-inline: 16px;
      font-size: 0.84rem;
    }

    .dandy-hero-facts {
      gap: 10px;
      padding-top: 12px;
      margin-top: 4px;
    }

    .dandy-hero-fact dd {
      font-size: 0.78rem;
      line-height: 1.4;
    }

    .dandy-hero-slides {
      aspect-ratio: 16 / 9;
    }
  }

  /* Mobile Editorial Composition (< 768px): image-first anchor with restrained height & full CTA discoverability */
  @media (max-width: 767px) {
    .dandy-hero {
      padding-block: 12px 24px;
    }

    .dandy-hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "visual"
        "copy";
      gap: 14px;
    }

    .dandy-hero-slides {
      width: 100%;
      height: clamp(185px, 50vw, 240px);
      aspect-ratio: auto;
    }

    .dandy-hero-controls {
      margin-top: 8px;
      gap: 10px;
    }

    .dandy-hero-nav-btn {
      width: 30px;
      height: 30px;
    }

    .dandy-hero-copy {
      gap: 8px;
    }

    .dandy-hero-kicker {
      font-size: 0.72rem;
    }

    .dandy-hero-title {
      font-size: clamp(1.38rem, 5.2vw, 1.68rem);
      line-height: 1.26;
      max-width: 100%;
    }

    .dandy-hero-subtitle {
      font-size: 0.82rem;
      line-height: 1.54;
    }

    .dandy-hero-actions {
      display: flex;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 8px;
      width: 100%;
      padding-top: 4px;
    }

    .dandy-hero-cta {
      flex: 1 1 auto;
      justify-content: center;
      min-height: 44px;
      padding-inline: 14px;
    }

    .dandy-hero-secondary-cta {
      flex: 0 0 auto;
      min-height: 44px;
      padding-inline: 14px;
    }

    .dandy-hero-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin-top: 4px;
      padding-top: 10px;
    }

    .dandy-hero-fact {
      gap: 2px;
    }

    .dandy-hero-fact dt {
      font-size: 0.68rem;
    }

    .dandy-hero-fact dd {
      font-size: 0.72rem;
      line-height: 1.35;
    }
  }

  @media (max-width: 359px) {
    .dandy-hero-actions {
      flex-wrap: wrap;
    }

    .dandy-hero-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
